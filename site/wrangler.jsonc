{
	// Cloudflare Workers static-assets config — the modern replacement for
	// classic Pages' dashboard "build output directory" field. Root
	// directory in the Cloudflare dashboard's Advanced settings must be set
	// to "site" so this file (and the ./dist it points to) resolves
	// correctly; see docs/TODO.md's Cloudflare setup notes.
	"name": "haxbyte",
	"compatibility_date": "2026-08-16",
	"assets": {
		"directory": "./dist"
	}
}
