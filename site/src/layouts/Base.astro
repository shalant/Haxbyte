---
import '../styles/tokens.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
}

const {
	title = 'Haxbyte',
	description = 'Doug Rosenberg — building software and writing about how.',
	image = '/haxbyte-logo.png',
	type = 'website',
} = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href);
};

const pageTitle = title === 'Haxbyte' ? title : `${title} — Haxbyte`;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preload" href="/fonts/ibm-plex-mono-700.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/source-serif-4-400.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline>
			// Runs before paint to avoid a flash of the wrong theme. Explicit
			// choice (from the toggle) wins; otherwise falls back to system
			// preference, matching tokens.css's [data-theme] / prefers-color-scheme rules.
			(function () {
				var stored = localStorage.getItem('haxbyte-theme');
				if (stored === 'dark' || stored === 'light') {
					document.documentElement.setAttribute('data-theme', stored);
				}
			})();
		</script>

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Haxbyte" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<slot name="head" />
	</head>
	<body>
		<header>
			<nav class="navbar">
				<a href="/" class="logo">
					<img src="/haxbyte-mark.png" alt="Haxbyte" class="logo-mark" />
					<span class="logo-text">Haxbyte</span>
				</a>
				<ul class="nav-links">
					<li><a href="/work" aria-current={isActive('/work') ? 'page' : undefined}>Builds</a></li>
					<li><a href="/blog" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a></li>
					<li><a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a></li>
					<li><a href="/contact" aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a></li>
					<li>
						<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode">
							<svg class="icon-sun" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
							<svg class="icon-moon" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z"/></svg>
						</button>
					</li>
				</ul>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<div class="footer-content">
				<div class="footer-brand">
					<img src="/haxbyte-mark.png" alt="Haxbyte" class="footer-mark" />
					<p>&copy; {new Date().getFullYear()} Haxbyte. All rights reserved.</p>
				</div>
				<div class="footer-links">
					<a href="/about">About</a>
					<a href="/contact">Contact</a>
				</div>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById('theme-toggle');
			const root = document.documentElement;

			function systemPrefersDark() {
				return window.matchMedia?.('(prefers-color-scheme: dark)').matches;
			}
			function current() {
				return root.getAttribute('data-theme') || (systemPrefersDark() ? 'dark' : 'light');
			}
			function apply(theme: string) {
				root.setAttribute('data-theme', theme);
				localStorage.setItem('haxbyte-theme', theme);
				toggle?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
			}

			toggle?.addEventListener('click', () => {
				apply(current() === 'dark' ? 'light' : 'dark');
			});
		</script>
	</body>
</html>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	header {
		background-color: var(--nav-glass);
		backdrop-filter: blur(14px) saturate(1.5);
		-webkit-backdrop-filter: blur(14px) saturate(1.5);
		color: var(--text);
		padding: var(--space-md);
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--nav-border);
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		header { background-color: var(--bg); }
	}

	.navbar {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		row-gap: var(--space-sm);
		justify-content: space-between;
		align-items: center;
		padding: 0 var(--space-md);
	}

	@media (max-width: 40rem) {
		.navbar { justify-content: center; text-align: center; }
		.nav-links { flex-wrap: wrap; justify-content: center; gap: var(--space-md); }
	}

	.logo {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		text-decoration: none;
		transition: opacity var(--duration-normal);
	}

	.logo:hover {
		opacity: 0.8;
	}

	.logo-mark {
		height: 32px;
		width: auto;
	}

	.logo-text {
		font-family: 'IBM Plex Mono', monospace;
		font-weight: 700;
		font-size: var(--text-lg);
		color: var(--text);
	}

	.nav-links {
		display: flex;
		align-items: center;
		list-style: none;
		gap: var(--space-lg);
		margin: 0;
	}

	.nav-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: var(--text-sm);
		transition: color var(--duration-normal);
		position: relative;
		padding-bottom: var(--space-xs);
	}

	.nav-links a:hover {
		color: var(--signal);
	}

	.nav-links a[aria-current="page"] {
		color: var(--signal);
		font-weight: 600;
	}

	.nav-links a[aria-current="page"]::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 2px;
		background-color: var(--spark);
		border-radius: 1px;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: var(--radius-md);
		border: 1px solid var(--nav-border);
		background: none;
		color: var(--text);
		cursor: pointer;
		transition: border-color var(--duration-fast), transform var(--duration-fast);
	}

	.theme-toggle:hover {
		border-color: var(--signal);
		transform: translateY(-1px);
	}

	.theme-toggle svg {
		width: 16px;
		height: 16px;
		stroke: currentColor;
		fill: none;
		stroke-width: 1.6;
	}

	.theme-toggle .icon-sun { display: block; }
	.theme-toggle .icon-moon { display: none; }

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme="light"])) .theme-toggle .icon-sun { display: none; }
		:global(:root:not([data-theme="light"])) .theme-toggle .icon-moon { display: block; }
	}
	:global(:root[data-theme="dark"]) .theme-toggle .icon-sun { display: none; }
	:global(:root[data-theme="dark"]) .theme-toggle .icon-moon { display: block; }

	main {
		min-height: calc(100vh - 200px);
	}

	footer {
		background: var(--bg);
		color: var(--text-muted);
		padding: var(--space-4xl) var(--space-md) var(--space-3xl);
		margin-top: var(--space-4xl);
		border-top: 1px solid var(--line);
	}

	.footer-content {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-2xl);
		flex-wrap: wrap;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: var(--space-md);
	}

	.footer-mark {
		height: 28px;
		width: auto;
		opacity: 0.9;
	}

	footer p {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.footer-links {
		display: flex;
		gap: var(--space-lg);
	}

	.footer-links a {
		color: var(--signal);
		text-decoration: none;
		font-size: var(--text-sm);
		transition: opacity var(--duration-normal);
	}

	.footer-links a:hover {
		opacity: 0.7;
	}
</style>
