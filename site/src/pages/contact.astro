---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Get in touch with Haxbyte">
	<div class="contact-container">
		<h1>Get in Touch</h1>

		<section class="contact-content">
			<div class="contact-intro">
				<p>
					Questions, feedback, or just want to talk shop? I'm easy to reach.
				</p>
			</div>

			<div class="contact-methods">
				<div class="contact-method">
					<h2>Email</h2>
					<p>
						<a href="mailto:doug.rosenberg@gmail.com">doug.rosenberg@gmail.com</a>
					</p>
					<p class="note">Best way to reach me directly</p>
				</div>

				<div class="contact-method">
					<h2>LinkedIn</h2>
					<p>
						<a href="https://linkedin.com/in/doug-rosenberg" target="_blank" rel="noopener">
							Connect on LinkedIn
						</a>
					</p>
					<p class="note">Follow along with projects and updates</p>
				</div>
			</div>

			<div class="contact-note">
				<p>
					I read every email and usually reply within a few days.
				</p>
			</div>
		</section>
	</div>
</Base>

<style>
	.contact-container {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		padding: var(--space-3xl) var(--space-md);
	}

	.contact-container h1 {
		margin-top: 0;
		text-align: center;
		margin-bottom: var(--space-2xl);
	}

	.contact-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-3xl);
	}

	.contact-intro {
		text-align: center;
		font-size: var(--text-lg);
		color: var(--ash);
		max-width: 50ch;
		margin: 0 auto;
	}

	.contact-methods {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-2xl);
		margin-bottom: var(--space-2xl);
	}

	.contact-method {
		padding: var(--space-lg);
		border: 1px solid rgba(11, 18, 32, 0.1);
		border-radius: var(--radius-md);
		background-color: var(--white);
		text-align: center;
	}

	.contact-method h2 {
		margin-top: 0;
		font-size: var(--text-xl);
	}

	.contact-method p {
		margin: var(--space-md) 0;
	}

	.contact-method a {
		font-weight: 600;
		color: var(--signal);
		text-decoration: none;
	}

	.contact-method a:hover {
		opacity: 0.8;
	}

	.note {
		font-size: var(--text-sm);
		color: var(--ash);
	}

	.contact-note {
		text-align: center;
		padding: var(--space-lg);
		background-color: rgba(45, 212, 191, 0.05);
		border-radius: var(--radius-md);
		border-left: 4px solid var(--signal);
	}

	.contact-note p {
		margin: 0;
		color: var(--ash);
	}
</style>
