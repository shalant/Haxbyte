---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../lib/posts';

const blogPosts = await getPublishedPosts();
const sortedPosts = blogPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Blog" description="Latest posts on building software and shipping in public">
	<div class="blog-container">
		<header class="blog-header">
			<h1>Blog</h1>
			<p>Build logs, technical notes, and thoughts on building in public.</p>
		</header>

		{sortedPosts.length > 0 && (
			<div class="search-box">
				<label for="blog-search" class="sr-only">Search posts</label>
				<input type="search" id="blog-search" placeholder="Search posts by title, tag, or topic&hellip;" autocomplete="off" />
			</div>
		)}

		<div class="posts-list" id="posts-list">
			{sortedPosts.map(post => {
				const searchIndex = [post.data.title, post.data.description, ...(post.data.tags ?? [])]
					.filter(Boolean)
					.join(' ')
					.toLowerCase();
				return (
					<article class="post-item" data-search={searchIndex}>
						<h2>
							<a href={`/blog/${post.id}`}>{post.data.title}</a>
						</h2>
						<div class="post-meta">
							<time datetime={post.data.date.toISOString()}>
								{post.data.date.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
							{post.data.tags && post.data.tags.length > 0 && (
								<div class="tags">
									{post.data.tags.map(tag => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)}
						</div>
						{post.data.description && <p class="description">{post.data.description}</p>}
					</article>
				);
			})}
		</div>

		<p class="no-results" id="no-results" hidden>No posts match your search.</p>

		{sortedPosts.length === 0 && (
			<p class="no-posts">No blog posts yet. Check back soon!</p>
		)}
	</div>

	<script>
		const input = document.getElementById('blog-search') as HTMLInputElement | null;
		const posts = Array.from(document.querySelectorAll<HTMLElement>('.post-item'));
		const noResults = document.getElementById('no-results');

		input?.addEventListener('input', () => {
			const query = input.value.trim().toLowerCase();
			let visibleCount = 0;

			for (const post of posts) {
				const matches = query === '' || (post.dataset.search ?? '').includes(query);
				post.hidden = !matches;
				if (matches) visibleCount++;
			}

			if (noResults) noResults.hidden = visibleCount > 0;
		});
	</script>
</Base>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.search-box {
		margin-bottom: var(--space-2xl);
	}

	.search-box input {
		width: 100%;
		min-height: 44px;
		padding: var(--space-sm) var(--space-md);
		font-family: 'Source Serif 4', 'Lora', serif;
		font-size: var(--text-base);
		color: var(--text);
		background-color: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		transition: border-color var(--duration-fast);
	}

	.search-box input:focus-visible {
		outline: none;
		border-color: var(--link);
	}

	.no-results {
		text-align: center;
		color: var(--text-muted);
		padding: var(--space-2xl) 0;
	}
	.blog-container {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		padding: var(--space-3xl) var(--space-md);
	}

	.blog-header {
		margin-bottom: var(--space-3xl);
		border-bottom: 1px solid var(--line);
		padding-bottom: var(--space-2xl);
	}

	.blog-header h1 {
		margin: 0 0 var(--space-md) 0;
	}

	.blog-header p {
		color: var(--text-muted);
		font-size: var(--text-lg);
		margin: 0;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xl);
	}

	.post-item {
		border-bottom: 1px solid var(--line);
		padding-bottom: var(--space-2xl);
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-item h2 {
		margin: 0 0 var(--space-md) 0;
		font-size: var(--text-2xl);
	}

	.post-item h2 a {
		color: var(--text);
		text-decoration: none;
	}

	.post-item h2 a:hover {
		color: var(--link);
	}

	.post-meta {
		display: flex;
		gap: var(--space-md);
		align-items: center;
		flex-wrap: wrap;
		font-family: 'IBM Plex Mono', monospace;
		font-size: var(--text-sm);
		color: var(--text-muted);
		margin-bottom: var(--space-md);
	}

	.tags {
		display: flex;
		gap: var(--space-sm);
		flex-wrap: wrap;
	}

	.tag {
		display: inline-block;
		background-color: rgba(45, 212, 191, 0.1);
		color: var(--link);
		padding: var(--space-2xs) var(--space-sm);
		border-radius: var(--radius-sm);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.description {
		color: var(--text-muted);
		font-size: var(--text-base);
		margin: 0;
	}

	.no-posts {
		text-align: center;
		color: var(--text-muted);
		padding: var(--space-3xl) 0;
	}
</style>
