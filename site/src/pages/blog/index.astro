---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../lib/posts';

const blogPosts = await getPublishedPosts();
const sortedPosts = blogPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Blog" description="Latest posts on building software and shipping in public">
	<div class="blog-container">
		<header class="blog-header">
			<h1>Blog</h1>
			<p>Build logs, technical notes, and thoughts on building in public.</p>
		</header>

		<div class="posts-list">
			{sortedPosts.map(post => (
				<article class="post-item">
					<h2>
						<a href={`/blog/${post.id}`}>{post.data.title}</a>
					</h2>
					<div class="post-meta">
						<time datetime={post.data.date.toISOString()}>
							{post.data.date.toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</time>
						{post.data.tags && post.data.tags.length > 0 && (
							<div class="tags">
								{post.data.tags.map(tag => (
									<span class="tag">{tag}</span>
								))}
							</div>
						)}
					</div>
					{post.data.description && <p class="description">{post.data.description}</p>}
				</article>
			))}
		</div>

		{sortedPosts.length === 0 && (
			<p class="no-posts">No blog posts yet. Check back soon!</p>
		)}
	</div>
</Base>

<style>
	.blog-container {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		padding: var(--space-3xl) var(--space-md);
	}

	.blog-header {
		margin-bottom: var(--space-3xl);
		border-bottom: 1px solid var(--line);
		padding-bottom: var(--space-2xl);
	}

	.blog-header h1 {
		margin: 0 0 var(--space-md) 0;
	}

	.blog-header p {
		color: var(--text-muted);
		font-size: var(--text-lg);
		margin: 0;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xl);
	}

	.post-item {
		border-bottom: 1px solid var(--line);
		padding-bottom: var(--space-2xl);
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-item h2 {
		margin: 0 0 var(--space-md) 0;
		font-size: var(--text-2xl);
	}

	.post-item h2 a {
		color: var(--text);
		text-decoration: none;
	}

	.post-item h2 a:hover {
		color: var(--link);
	}

	.post-meta {
		display: flex;
		gap: var(--space-md);
		align-items: center;
		flex-wrap: wrap;
		font-family: 'IBM Plex Mono', monospace;
		font-size: var(--text-sm);
		color: var(--text-muted);
		margin-bottom: var(--space-md);
	}

	.tags {
		display: flex;
		gap: var(--space-sm);
		flex-wrap: wrap;
	}

	.tag {
		display: inline-block;
		background-color: rgba(45, 212, 191, 0.1);
		color: var(--link);
		padding: var(--space-2xs) var(--space-sm);
		border-radius: var(--radius-sm);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.description {
		color: var(--text-muted);
		font-size: var(--text-base);
		margin: 0;
	}

	.no-posts {
		text-align: center;
		color: var(--text-muted);
		padding: var(--space-3xl) 0;
	}
</style>
