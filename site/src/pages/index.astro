---
import Base from '../layouts/Base.astro';
import PulseLine from '../components/PulseLine.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const recentPosts = blogPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
---

<Base>
	<!-- Hero Section -->
	<section class="hero">
		<div class="hero-inner">
			<div class="hero-mark">
				<img src="/haxbyte-mark.png" alt="Haxbyte mark" class="hero-logo" />
			</div>
			<div class="hero-content">
				<h1>Web development for small business</h1>
				<p>Turn ideas into working websites. Launch fast. Build smart.</p>
				<a href="/contact" class="cta-button">Get in touch</a>
			</div>
			<PulseLine variant="hero" />
		</div>
	</section>

	<PulseLine variant="divider" />

	<!-- Services Section -->
	<section class="services container">
		<h2>What we build</h2>
		<div class="service-grid">
			<div class="service-card">
				<h3>Website Launches</h3>
				<p>Fast, modern sites that actually work. No bloat. No unnecessary framework overhead.</p>
			</div>
			<div class="service-card">
				<h3>Redesigns</h3>
				<p>Give your site a fresh start. Better performance, cleaner design, real results.</p>
			</div>
			<div class="service-card">
				<h3>Custom Builds</h3>
				<p>Tailored web solutions for your specific needs. Built to last, optimized for speed.</p>
			</div>
		</div>
	</section>

	<PulseLine variant="divider" />

	<!-- Recent Posts -->
	<section class="recent-posts container">
		<h2>Latest posts</h2>
		<div class="posts-grid">
			{recentPosts.map(post => (
				<article class="post-card">
					<h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
					<time datetime={post.data.date.toISOString()}>
						{post.data.date.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
					{post.data.description && <p>{post.data.description}</p>}
				</article>
			))}
		</div>
	</section>
</Base>

<style>
	.hero {
		background-color: var(--ink);
		color: var(--white);
		padding: var(--space-5xl) var(--space-md);
		text-align: center;
	}

	.hero-inner {
		max-width: var(--max-width-prose);
		margin: 0 auto;
	}

	.hero-mark {
		margin-bottom: var(--space-3xl);
		display: flex;
		justify-content: center;
	}

	.hero-logo {
		height: 120px;
		width: auto;
		filter: drop-shadow(0 4px 12px rgba(45, 212, 191, 0.3));
	}

	.hero-content {
		max-width: var(--max-width-prose);
		margin: 0 auto var(--space-3xl);
	}

	.hero h1 {
		color: var(--white);
		margin: 0 0 var(--space-md) 0;
		font-size: var(--text-6xl);
	}

	.hero p {
		font-size: var(--text-xl);
		color: var(--paper);
		margin-bottom: var(--space-lg);
	}

	.cta-button {
		display: inline-block;
		background-color: var(--spark);
		color: var(--white);
		padding: var(--space-md) var(--space-lg);
		border-radius: var(--radius-md);
		text-decoration: none;
		font-weight: 600;
		transition: opacity var(--duration-normal);
	}

	.cta-button:hover {
		opacity: 0.9;
	}

	.services {
		padding: var(--space-3xl) var(--space-md);
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: var(--space-2xl);
		margin-top: var(--space-2xl);
	}

	.service-card {
		padding: var(--space-lg);
		border: 2px solid transparent;
		border-radius: var(--radius-md);
		background-color: var(--white);
		box-shadow: 0 2px 8px rgba(11, 18, 32, 0.08);
		transition: all var(--duration-normal);
		position: relative;
		overflow: hidden;
	}

	.service-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, var(--signal), var(--spark));
	}

	.service-card:hover {
		box-shadow: 0 8px 20px rgba(11, 18, 32, 0.15);
		transform: translateY(-4px);
	}

	.service-card h3 {
		margin-top: 0;
		color: var(--ink);
		font-size: var(--text-lg);
	}

	.recent-posts {
		padding: var(--space-3xl) var(--space-md);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-2xl);
		margin-top: var(--space-2xl);
	}

	.post-card {
		padding: var(--space-lg);
		border-left: 4px solid var(--spark);
		border-radius: var(--radius-md);
		background-color: var(--white);
		box-shadow: 0 2px 8px rgba(11, 18, 32, 0.06);
		transition: all var(--duration-normal);
	}

	.post-card:hover {
		box-shadow: 0 6px 16px rgba(11, 18, 32, 0.12);
		transform: translateX(4px);
	}

	.post-card h3 {
		margin-top: 0;
		margin-bottom: var(--space-sm);
		font-size: var(--text-lg);
	}

	.post-card a {
		color: var(--ink);
		text-decoration: none;
	}

	.post-card a:hover {
		color: var(--spark);
	}

	.post-card time {
		font-family: 'IBM Plex Mono', monospace;
		font-size: var(--text-sm);
		color: var(--ash);
	}
</style>
