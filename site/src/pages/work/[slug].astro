---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const workPieces = await getCollection('work');
	return workPieces.map(piece => ({
		params: { slug: piece.id },
		props: { piece },
	}));
}

interface Props {
	piece: any;
}

const { piece } = Astro.props;
---

<Base title={piece.data.title} description={piece.data.description}>
	<article class="work-piece">
		<header class="piece-header">
			<h1>{piece.data.title}</h1>
			<div class="piece-meta">
				<span class="client">{piece.data.client}</span>
				{piece.data.tags && piece.data.tags.length > 0 && (
					<div class="tags">
						{piece.data.tags.map(tag => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)}
			</div>
		</header>
		<div class="piece-content">
			<Fragment set:html={piece.body} />
		</div>
	</article>
</Base>

<style>
	.work-piece {
		max-width: var(--max-width-prose);
		margin: var(--space-3xl) auto;
		padding: 0 var(--space-md);
	}

	.piece-header {
		margin-bottom: var(--space-3xl);
		border-bottom: 1px solid var(--line);
		padding-bottom: var(--space-2xl);
	}

	.piece-header h1 {
		margin-top: 0;
	}

	.piece-meta {
		display: flex;
		gap: var(--space-md);
		align-items: center;
		flex-wrap: wrap;
		font-family: 'IBM Plex Mono', monospace;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.client {
		font-weight: 600;
		color: var(--text);
	}

	.tags {
		display: flex;
		gap: var(--space-sm);
		flex-wrap: wrap;
	}

	.tag {
		display: inline-block;
		background-color: rgba(232, 112, 63, 0.1);
		color: var(--link-orange);
		padding: var(--space-2xs) var(--space-sm);
		border-radius: var(--radius-sm);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.piece-content {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
	}

	:global(.piece-content p) {
		margin-bottom: var(--space-lg);
	}

	:global(.piece-content h2) {
		margin-top: var(--space-3xl);
	}

	:global(.piece-content img) {
		max-width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		margin: var(--space-2xl) 0;
	}
</style>
